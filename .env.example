# ============ 服务 ============
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# 业务时钟：demo = 使用 DEMO_NOW（比赛演示）；real = 使用真实时间
# 不设置时：simulated -> demo，BANKING_MODE=http -> real
# BUSINESS_CLOCK=real

# 演示时钟：保证“生日前 2 天”“当月账单”等相对日期稳定；安全 TTL 始终使用真实墙钟
DEMO_NOW=2026-10-30T10:00:00+08:00

# 公网 HTTPS 部署必须设为 1
COOKIE_SECURE=0

# 不设置则自动生成到 DATA_DIR/runtime/auth-secret
# AUTH_SECRET=

# ============ 账号安全策略 ============
# 注册是否需要短信验证码（默认 1；仅本地演示可设 0，公网部署请保持 1）
AUTH_REQUIRE_PHONE_VERIFY=1
# 密码登录后是否再要求一次短信验证（默认 0，行内生产建议 1）
LOGIN_MFA=0

# 前端构建标注：0 = 纯产品版（去掉"演示/合成数据"标注），默认带标注
# 用法：VITE_DEMO_LABELS=0 npm run build   （或直接 npm run build）
VITE_DEMO_LABELS=0

# ============ LLM（服务端专用，切勿提交真实 Key） ============
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_OFFLINE=0
LLM_DAILY_LIMIT=500

# ============ 银行核心接入 ============
# simulated: 本地仿真，比赛演示默认
# http:      通过签名网关读写真实银行账户；配置不完整时服务启动即失败，绝不静默回退仿真
BANKING_MODE=simulated
BANKING_BASE_URL=
BANKING_APP_ID=
BANKING_APP_SECRET=
BANKING_PROVIDER=合作银行核心
BANKING_TIMEOUT_MS=8000
BANKING_RETRIES=1
BANKING_SYNC_TTL_MS=2500
BANKING_TXN_LIMIT=600
BANKING_CIRCUIT_FAILURES=5
BANKING_CIRCUIT_COOLDOWN_MS=30000

# ============ 短信验证码通道 ============
# demo: 服务端下发演示码 246810；http: 调用签约短信/核验服务
SMS_MODE=demo
SMS_BASE_URL=
SMS_APP_ID=
SMS_APP_SECRET=
SMS_TIMEOUT_MS=6000
SMS_RESEND_COOLDOWN_MS=60000

# ============ 人脸 / 活体核验通道 ============
# demo: 页面内演示；http: 创建核验会话并轮询服务端结果
FACE_MODE=demo
FACE_BASE_URL=
FACE_APP_ID=
FACE_APP_SECRET=
FACE_TIMEOUT_MS=8000
